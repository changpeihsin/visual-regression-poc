{
  "name": "visual-regression-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Percy-like visual regression testing POC: Playwright capture + odiff pixel compare + DOM root cause analysis.",
  "bin": {
    "vrt": "./src/cli.ts"
  },
  "scripts": {
    "vrt": "tsx src/cli.ts",
    "e2e:dev": "tsx watch src/e2e/server.ts",
    "e2e:start": "tsx src/e2e/server.ts",
    "test:demo": "playwright test --config=playwright.config.ts",
    "demo:baseline": "VRT_TARGET=baseline VRT_DEMO_VERSION=v1 pnpm test:demo",
    "demo:current": "VRT_TARGET=current VRT_DEMO_VERSION=v2 pnpm test:demo",
    "demo": "pnpm demo:baseline && pnpm demo:current && pnpm vrt compare --open",
    "test:joie": "playwright test --config=playwright.joie.config.ts",
    "joie:baseline": "VRT_TARGET=baseline pnpm test:joie",
    "joie:current": "VRT_TARGET=current pnpm test:joie",
    "joie": "pnpm joie:baseline && pnpm joie:current && pnpm vrt compare --open",
    "dev:fixtures": "tsx src/dev/makeFixtures.ts",
    "dev:fixtures:compare": "pnpm dev:fixtures && pnpm vrt compare --open",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "odiff-bin": "^4.3.8",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "odiff-bin"]
  }
}
